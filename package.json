{
  "name": "solagent",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "tsx watch packages/api/src/server.ts",
    "dev:web": "npm run dev -w apps/web",
    "start": "tsx packages/api/src/server.ts",
    "demo": "tsx scripts/demo.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  },
  "engines": {
    "node": ">=22.13"
  }
}
