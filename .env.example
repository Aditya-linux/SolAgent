# Planning agent (optional; deterministic optimizer is used when unset)
ANTHROPIC_API_KEY=
PLANNER_MODEL=claude-opus-5-5
PLANNER_EFFORT=high

# Duffel (flights search + booking). Use a test-mode token: duffel_test_...
DUFFEL_ACCESS_TOKEN=

# Which suppliers to use: "mock" (default) or "duffel" for flights
FLIGHT_PROVIDER=mock

# Spends above this need the traveler's signature (default 50000 = $500)
AUTO_APPROVE_UP_TO_CENTS=50000

# Where trips are persisted. A file path (default: data/trips.db) survives
# restarts; ":memory:" is handy for a throwaway demo.
DATABASE_PATH=data/trips.db

PORT=8787
