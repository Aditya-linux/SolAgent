# Planning agent (optional; deterministic optimizer is used when unset)
ANTHROPIC_API_KEY=
PLANNER_MODEL=claude-opus-5-5
PLANNER_EFFORT=high

# Duffel (flights search + booking). Use a test-mode token: duffel_test_...
DUFFEL_ACCESS_TOKEN=

# Which suppliers to use: "mock" (default) or "duffel" for flights
FLIGHT_PROVIDER=mock

PORT=8787
